---
import { Image } from 'astro:assets';
import portrait from '../images/portrait.jpeg';
---

<button class="stamp" type="button" aria-label="Peel off the portrait stamp" data-state="attached" data-portrait-stamp>
  <span class="stamp-placeholder" aria-hidden="true"><span>+</span>Another?</span>
  <span class="stamp-carrier">
  <span class="stamp-paper">
    <span class="stamp-face">
      <Image src={portrait} alt="Kacper Cygan" width={160} height={160} quality={90} />
      <span class="stamp-caption" aria-hidden="true">KACPER · 1st</span>
    </span>
  </span>
  <span class="stamp-roll" aria-hidden="true"></span>
  </span>
</button>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-portrait-stamp]').forEach((stamp) => {
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const settle = () => {
      const removed = stamp.dataset.state === 'removing';
      stamp.dataset.state = removed ? 'removed' : 'attached';
      stamp.removeAttribute('aria-busy');
      stamp.setAttribute('aria-label', removed ? 'Put on a new portrait stamp' : 'Peel off the portrait stamp');
    };
    stamp.addEventListener('click', () => {
      if (stamp.dataset.state === 'removing' || stamp.dataset.state === 'restoring') return;
      stamp.dataset.state = stamp.dataset.state === 'removed' ? 'restoring' : 'removing';
      stamp.setAttribute('aria-busy', 'true');
      if (motion.matches) settle();
    });
    stamp.addEventListener('animationend', (event) => {
      if (event.animationName === 'stamp-peel' && event.target instanceof Element && event.target.classList.contains('stamp-carrier')) settle();
    });
    motion.addEventListener('change', () => {
      if (motion.matches && (stamp.dataset.state === 'removing' || stamp.dataset.state === 'restoring')) settle();
    });
  });
</script>

<style>
  @property --peel {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 0%;
  }

  .stamp-placeholder {
    position: absolute;
    inset: 3px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border: 1px dashed var(--rule);
    border-radius: 3px;
    color: var(--muted);
    font: 10px/1.3 var(--font-sans);
    opacity: 0;
    transition: opacity 250ms ease, border-color 180ms ease;
  }

  .stamp-placeholder > span { font: 24px/1 var(--font-serif); }
  .stamp[data-state='removed'] .stamp-placeholder { opacity: 1; }
  .stamp[data-state='removed']:hover .stamp-placeholder { border-color: var(--accent); }

  .stamp-carrier {
    --peel: 0%;
    display: block;
    position: relative;
    filter: drop-shadow(1px 2px 1px rgb(29 28 25 / 0.22));
    transform-origin: top center;
  }

  .stamp[data-state='removed'] .stamp-carrier { visibility: hidden; }
  .stamp[data-state='removing'] .stamp-carrier { animation: stamp-peel 780ms cubic-bezier(0.45, 0, 0.25, 1) both; }
  .stamp[data-state='restoring'] .stamp-carrier { animation: stamp-peel 850ms cubic-bezier(0.45, 0, 0.25, 1) reverse both; }

  @keyframes stamp-peel {
    0% { --peel: 0%; transform: translate(0, 0) rotate(0deg); opacity: 1; }
    18% { --peel: 10%; transform: translate(0, -1px) rotate(-2deg); opacity: 1; }
    75% { --peel: 88%; transform: translate(-2px, -4px) rotate(-7deg); opacity: 1; }
    100% { --peel: 100%; transform: translate(-10px, -22px) rotate(-14deg); opacity: 0; }
  }

  .stamp-roll {
    position: absolute;
    left: 0;
    right: 0;
    bottom: var(--peel);
    height: 0;
    transform: translateY(55%);
    border-radius: 2px 2px 45% 45% / 2px 2px 5px 5px;
    background: linear-gradient(to bottom, #aaa18e 0%, #e6ddc9 16%, #fffdf4 43%, #f4eedf 67%, #c7bda7 96%);
    box-shadow: 0 5px 5px rgb(29 28 25 / 0.2);
    opacity: 0;
    pointer-events: none;
  }

  .stamp[data-state='removing'] .stamp-roll { animation: stamp-curl 780ms cubic-bezier(0.45, 0, 0.25, 1) both; }
  .stamp[data-state='restoring'] .stamp-roll { animation: stamp-curl 850ms cubic-bezier(0.45, 0, 0.25, 1) reverse both; }

  @keyframes stamp-curl {
    0% { height: 0; opacity: 0; }
    12% { height: 12px; opacity: 1; }
    55% { height: 21px; opacity: 1; }
    85% { height: 13px; opacity: 1; }
    100% { height: 3px; opacity: 0; }
  }

  .stamp {
    flex: 0 0 auto;
    display: block;
    position: relative;
    width: 5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    transform: rotate(-5deg);
    transform-origin: bottom left;
    transition: transform 220ms ease;
  }

  .stamp-paper {
    display: block;
    position: relative;
    padding: 7px;
    background: #fffdf7;
    mask:
      radial-gradient(circle at 4px 0, transparent 2px, #000 2.6px) 0 0 / 8px 100%,
      radial-gradient(circle at 4px 100%, transparent 2px, #000 2.6px) 0 0 / 8px 100%,
      radial-gradient(circle at 0 4px, transparent 2px, #000 2.6px) 0 0 / 100% 8px,
      radial-gradient(circle at 100% 4px, transparent 2px, #000 2.6px) 0 0 / 100% 8px;
    mask-composite: intersect;
    clip-path: inset(0 0 var(--peel) 0);
  }

  .stamp-face {
    display: block;
    padding: 3px 3px 0;
    border: 1px solid #858073;
  }

  .stamp-face img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    filter: sepia(0.16);
  }

  .stamp-caption {
    display: block;
    padding-block: 3px 2px;
    color: #514b3d;
    font-family: var(--font-serif);
    font-size: 8px;
    letter-spacing: 0.08em;
    line-height: 1;
    white-space: nowrap;
  }

  .stamp:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 5px;
    border-radius: 2px;
  }

  @media (hover: hover) {
    .stamp[data-state='attached']:hover { transform: rotate(-7deg) translateY(-2px); }
    .stamp[data-state='attached']:hover .stamp-carrier { --peel: 4%; }
    .stamp[data-state='attached']:hover .stamp-roll { height: 7px; opacity: 1; }
  }

  @media (prefers-reduced-motion: reduce) {
    .stamp, .stamp-placeholder { transition: none; }
  }
</style>
