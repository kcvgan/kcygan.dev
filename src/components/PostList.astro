---
import { formatDate, type BlogPost } from '../lib/posts';

interface Props {
  posts: BlogPost[];
}

const { posts } = Astro.props;
---

<ol class="post-list">
  {posts.map((post: BlogPost) => (
    <li>
      <a href={`/blog/${post.id}`}>
        <span class="post-title">{post.data.title}</span>
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
      </a>
    </li>
  ))}
</ol>

<style>
  .post-list {
    list-style: none;
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
  }

  li {
    margin: 0;
  }

  a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: baseline;
    color: inherit;
    text-decoration: none;
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.006em;
    text-wrap: pretty;
    transition: color 160ms ease;
  }

  time {
    color: var(--muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  a:hover .post-title,
  a:focus-visible .post-title {
    color: var(--accent);
  }

  @media (max-width: 30rem) {
    a {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }

    time {
      font-size: 0.74rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .post-title {
      transition: none;
    }
  }
</style>
