---
import { Image } from 'astro:assets';
import avatar from '../images/avatar.jpg';
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Kacper Cygan writes about software, products, and the work behind them.',
  image,
} = Astro.props;

const pageTitle = title === 'Home' ? 'Kacper Cygan' : `${title} — Kacper Cygan`;
const canonicalURL = Astro.site
  ? new URL(Astro.url.pathname, Astro.site)
  : Astro.url;
const socialImage = image && Astro.site ? new URL(image, Astro.site) : undefined;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="Kacper Cygan" />
    <meta name="theme-color" content="#f7f5ef" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Kacper Cygan" href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kacper Cygan" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    <header class="site-header">
      <div class="site-shell">
        <a class="site-name" href="/" aria-label="Kacper Cygan, home">
          <Image
            class="site-avatar"
            src={avatar}
            alt=""
            width={72}
            height={72}
            quality={85}
          />
          Kacper Cygan
        </a>
        <nav aria-label="Primary navigation">
          <a href="/blog" aria-current={pathname.startsWith('/blog') ? 'page' : undefined}>
            Writing
          </a>
          <a href="https://github.com/kcvgan" rel="me">GitHub</a>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-shell">
        <p>© {new Date().getFullYear()} Kacper Cygan</p>
        <a href="/rss.xml">RSS</a>
      </div>
    </footer>
  </body>
</html>
