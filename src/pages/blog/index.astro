---
import PostList from '../../components/PostList.astro';
import Layout from '../../layouts/Layout.astro';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Layout
  title="Writing"
  description="Essays and notes by Kacper Cygan on software, products, and work."
>
  <div class="writing-page">
    <h1>Writing</h1>

    {posts.length > 0 ? <PostList posts={posts} /> : <p>No writing yet.</p>}
  </div>
</Layout>

<style>
  .writing-page {
    width: min(100% - 3rem, var(--measure));
    margin: 4rem auto 0;
  }

  h1 {
    margin: 0 0 2.5rem;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  @media (max-width: 36rem) {
    .writing-page {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 3rem;
    }
  }
</style>
