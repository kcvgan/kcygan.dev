---
import { getCollection, render } from 'astro:content';
import readingTime from 'reading-time';
import Layout from '../../layouts/Layout.astro';
import { formatDate, type BlogPost } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post: BlogPost) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const stats = readingTime(post.body ?? '');
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
>
  <article>
    <header class="article-header">
      <a class="back-link" href="/blog"><span aria-hidden="true">←</span> Writing</a>
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="description">{post.data.description}</p>}
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{stats.text}</span>
      </p>
    </header>

    {post.data.image && (
      <img
        class="cover"
        src={post.data.image}
        alt={post.data.imageAlt ?? ''}
      />
    )}

    <div class="prose">
      <Content />
    </div>
  </article>
</Layout>

<style>
  article {
    width: min(100% - 3rem, var(--measure));
    margin: 4rem auto 0;
  }

  .article-header {
    margin-bottom: 3.2rem;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2.2rem;
    color: var(--muted);
    font-size: 0.78rem;
    text-decoration: none;
  }

  h1 {
    max-width: 16ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.55rem, 7vw, 4.5rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 1.01;
    text-wrap: balance;
  }

  .description {
    max-width: 38rem;
    margin: 1.35rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    gap: 0.55rem;
    margin: 1.35rem 0 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .cover {
    width: min(62rem, calc(100vw - 2rem));
    max-width: none;
    height: auto;
    max-height: 70vh;
    margin: 0 0 3.5rem 50%;
    transform: translateX(-50%);
    object-fit: cover;
  }

  .prose {
    font-family: var(--font-serif);
    font-size: clamp(1.14rem, 1.5vw, 1.23rem);
    line-height: 1.72;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre),
  .prose :global(table) {
    margin: 0 0 1.45em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .prose :global(h2) {
    margin: 2.25em 0 0.7em;
    font-size: 1.75rem;
  }

  .prose :global(h3) {
    margin: 2em 0 0.65em;
    font-size: 1.35rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.35em;
  }

  .prose :global(li) {
    margin-bottom: 0.4em;
    padding-left: 0.2em;
  }

  .prose :global(a) {
    color: var(--accent);
  }

  .prose :global(blockquote) {
    margin-left: 0;
    padding-left: 1.25em;
    border-left: 2px solid var(--accent);
    color: #514e47;
    font-style: italic;
  }

  .prose :global(hr) {
    width: 5rem;
    height: 1px;
    margin: 3em auto;
    border: 0;
    background: var(--rule);
  }

  .prose :global(img) {
    width: auto;
    height: auto;
    margin: 2em auto 1.5em;
  }

  .prose :global(code) {
    padding: 0.12em 0.3em;
    border-radius: 3px;
    background: var(--paper-deep);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.82em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: #f0ede5 !important;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    padding: 0;
    background: transparent;
    font-size: inherit;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.82rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th:first-child),
  .prose :global(td:first-child) {
    padding-left: 0;
  }

  @media (max-width: 36rem) {
    article {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 3rem;
    }

    .article-header {
      margin-bottom: 2.6rem;
    }

    .back-link {
      margin-bottom: 1.65rem;
    }

    h1 {
      font-size: clamp(2.45rem, 13vw, 3.55rem);
    }

    .cover {
      margin-bottom: 2.6rem;
    }

    .prose {
      font-size: 1.12rem;
      line-height: 1.68;
    }

    .prose :global(pre) {
      margin-inline: -0.35rem;
      padding: 1rem;
      font-size: 0.72rem;
    }
  }
</style>
