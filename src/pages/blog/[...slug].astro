---
import { getCollection, render } from 'astro:content';
import readingTime from 'reading-time';
import Layout from '../../layouts/Layout.astro';
import { formatDate, type BlogPost } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return posts.map((post: BlogPost) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const stats = readingTime(post.body ?? '');
const minutes = Math.ceil(stats.minutes);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  image={post.data.image}
  reader
>
  <header class="reader-bar reader-top">
    <div class="reader-inner">
      <a class="back-link" href="/" aria-label="Back to Writing">
        <span aria-hidden="true">←</span> <span class="back-label">Writing</span>
      </a>
      <p class="reader-title">{post.data.title}</p>
      <time class="reader-date" datetime={post.data.date.toISOString()}>
        {formatDate(post.data.date)}
      </time>
    </div>
  </header>

  <div class="reader-scroll" data-reader-scroll>
  <article>
    <header class="article-header">
      <h1>{post.data.title}</h1>
      {post.data.description && <p class="description">{post.data.description}</p>}
      <p class="meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span aria-hidden="true">·</span>
        <span>{stats.text}</span>
      </p>
    </header>

    {post.data.image && (
      <img
        class="cover"
        src={post.data.image}
        alt={post.data.imageAlt ?? ''}
      />
    )}

    <div class="prose" data-prose>
      <Content />
    </div>
    <div class="end-mark" aria-hidden="true">❦</div>
  </article>
  </div>

  <footer class="reader-bar reader-bottom">
    <div class="reader-inner">
      <div class="reader-progress" aria-hidden="true" data-reader-progress></div>
      <span class="reader-time" data-reader-time data-minutes={minutes}>{stats.text}</span>
    </div>
  </footer>
</Layout>

<script>
  const scroller = document.querySelector<HTMLElement>('[data-reader-scroll]');
  const prose = document.querySelector<HTMLElement>('[data-prose]');
  const progressBar = document.querySelector<HTMLElement>('[data-reader-progress]');
  const timeLabel = document.querySelector<HTMLElement>('[data-reader-time]');

  if (scroller && prose && progressBar && timeLabel) {
    const totalMinutes = Number(timeLabel.dataset.minutes);
    let frame = 0;

    const update = () => {
      frame = 0;
      const rect = prose.getBoundingClientRect();
      const { top: viewTop, bottom: viewBottom } = scroller.getBoundingClientRect();
      const travel = rect.height - (viewBottom - viewTop);
      // Without real scrollable travel (layout not ready, or the article fits
      // the viewport) there is nothing to finish, so stay at 0 / "N min read".
      const progress =
        travel > 1 ? Math.min(Math.max((viewTop - rect.top) / travel, 0), 1) : 0;

      progressBar.style.transform = `scaleX(${progress})`;
      timeLabel.textContent =
        progress === 0
          ? `${totalMinutes} min read`
          : progress === 1
            ? 'Finished'
            : `${Math.max(1, Math.ceil(totalMinutes * (1 - progress)))} min left`;
    };

    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    scroller.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    window.addEventListener('load', schedule);
    if (typeof ResizeObserver !== 'undefined') {
      const observer = new ResizeObserver(schedule);
      observer.observe(prose);
      observer.observe(scroller);
    }
    document.fonts?.ready.then(schedule);
    update();
    schedule();
  }
</script>

<style>
  /* Bars sit in the fixed reader body; only .reader-scroll scrolls (see html.reader in global.css). */
  .reader-bar {
    flex: none;
    position: relative;
    z-index: 1;
    background: rgb(251 250 247 / 0.86);
  }

  .reader-top {
    border-bottom: 1px solid var(--rule);
  }

  .reader-bottom {
    border-top: 1px solid var(--rule);
  }

  .reader-scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
    scroll-padding-block: 1.5rem;
  }

  .reader-inner {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.85rem 1.5rem;
    color: var(--muted);
    font-size: 0.76rem;
    line-height: 1.3;
  }

  .reader-bottom .reader-inner {
    justify-content: center;
    padding-block: 0.6rem;
  }

  .back-link {
    flex-shrink: 0;
    color: var(--muted);
    text-decoration: none;
  }

  .reader-title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: 0.92rem;
    font-weight: 600;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .reader-date {
    flex-shrink: 0;
  }

  .reader-progress {
    position: absolute;
    top: -1px;
    left: 0;
    width: 100%;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 160ms linear;
  }

  .reader-time {
    font-variant-numeric: tabular-nums;
  }

  @media (prefers-reduced-motion: reduce) {
    .reader-progress {
      transition: none;
    }
  }

  .end-mark {
    margin: 2.5rem auto 3.5rem;
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    text-align: center;
  }

  article {
    width: min(100% - 3rem, var(--measure));
    margin: 0 auto;
    padding: 4rem 0 2.5rem;
  }

  .article-header {
    margin-bottom: 3.2rem;
  }

  h1 {
    max-width: 20ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.25rem, 5vw, 3.25rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .description {
    max-width: 38rem;
    margin: 1.35rem 0 0;
    color: var(--muted);
    font-size: 1.08rem;
    line-height: 1.65;
    text-wrap: pretty;
  }

  .meta {
    display: flex;
    gap: 0.55rem;
    margin: 1.35rem 0 0;
    color: var(--muted);
    font-size: 0.76rem;
  }

  .cover {
    width: min(62rem, calc(100vw - 2rem));
    max-width: none;
    height: auto;
    max-height: 70vh;
    margin: 0 0 3.5rem 50%;
    transform: translateX(-50%);
    object-fit: cover;
  }

  .prose {
    font-family: var(--font-serif);
    font-size: clamp(1.14rem, 1.5vw, 1.23rem);
    line-height: 1.72;
  }

  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol),
  .prose :global(blockquote),
  .prose :global(pre),
  .prose :global(table) {
    margin: 0 0 1.45em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.18;
    text-wrap: balance;
  }

  .prose :global(h2) {
    margin: 2.25em 0 0.7em;
    font-size: 1.75rem;
  }

  .prose :global(h3) {
    margin: 2em 0 0.65em;
    font-size: 1.35rem;
  }

  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.35em;
  }

  .prose :global(li) {
    margin-bottom: 0.4em;
    padding-left: 0.2em;
  }

  .prose :global(a) {
    color: var(--accent);
  }

  .prose :global(blockquote) {
    margin-left: 0;
    padding-left: 1.25em;
    border-left: 2px solid var(--accent);
    color: #4f4d5c;
    font-style: italic;
  }

  .prose :global(hr) {
    width: 5rem;
    height: 1px;
    margin: 3em auto;
    border: 0;
    background: var(--rule);
  }

  .prose :global(img) {
    width: auto;
    height: auto;
    margin: 2em auto 1.5em;
  }

  .prose :global(code) {
    padding: 0.12em 0.3em;
    border-radius: 3px;
    background: var(--paper-deep);
    font-family: ui-monospace, "SFMono-Regular", Consolas, monospace;
    font-size: 0.82em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1.25rem 1.35rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: #f4f3fb !important;
    font-size: 0.78rem;
    line-height: 1.6;
  }

  .prose :global(pre code) {
    padding: 0;
    background: transparent;
    font-size: inherit;
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.82rem;
  }

  .prose :global(th),
  .prose :global(td) {
    padding: 0.65rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    vertical-align: top;
  }

  .prose :global(th:first-child),
  .prose :global(td:first-child) {
    padding-left: 0;
  }

  @media (max-width: 36rem) {
    article {
      width: min(100% - 2.5rem, var(--measure));
      padding-top: 2.75rem;
    }

    .article-header {
      margin-bottom: 2.6rem;
    }

    .reader-inner {
      gap: 0.75rem;
      padding-inline: 1.1rem;
    }

    .reader-title {
      text-align: left;
    }

    h1 {
      font-size: 2.25rem;
    }

    .cover {
      margin-bottom: 2.6rem;
    }

    .prose {
      font-size: 1.12rem;
      line-height: 1.68;
    }

    .prose :global(pre) {
      margin-inline: -0.35rem;
      padding: 1rem;
      font-size: 0.72rem;
    }
  }

  @media (max-width: 30rem) {
    .back-label {
      display: none;
    }
  }
</style>
