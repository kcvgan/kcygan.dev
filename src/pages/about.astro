---
import { Image } from 'astro:assets';
import avatar from '../images/avatar.jpg';
import AshbyLink from '../components/AshbyLink.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About"
  description="About Kacper Cygan, a product engineer at Ashby who publishes fiction and nonfiction."
>
  <div class="about-page">
    <h1>About</h1>

    <div class="about-content">
      <Image
        class="portrait"
        src={avatar}
        alt="Kacper Cygan"
        width={224}
        height={224}
        quality={90}
      />

      <div class="prose">
        <p>
          I’m Kacper, a product engineer at <AshbyLink />. I’m interested in useful
          products, thoughtful interfaces, and doing good work.
        </p>
        <p>
          I like to write about different things. This site is where I publish notes
          about software, products, and things I learn, along with fiction and nonfiction.
        </p>
        <p class="links">
          <a href="mailto:hello@kcygan.dev">Email me</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/kcvgan" rel="me">GitHub</a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .about-page {
    width: min(100% - 3rem, var(--measure));
    margin: 4rem auto 0;
  }

  h1 {
    margin: 0 0 2.5rem;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .about-content {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .portrait {
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 35%;
  }

  .prose {
    max-width: 34rem;
    font-family: var(--font-serif);
    font-size: 1.18rem;
    line-height: 1.7;
  }

  .prose p {
    margin: 0 0 1.25em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.82rem;
  }

  .links a {
    color: var(--ink);
  }

  @media (max-width: 36rem) {
    .about-page {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 3rem;
    }

    .about-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .portrait {
      width: 5rem;
      height: 5rem;
    }

    .prose {
      font-size: 1.12rem;
    }
  }
</style>
