---
import { Image } from 'astro:assets';
import portrait from '../images/portrait.jpeg';
import AshbyLink from '../components/AshbyLink.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About"
  description="Meet Kacper Cygan: product engineer at Ashby, enjoying fatherhood, reading, and lately, writing."
>
  <div class="about-page">
    <h1>About</h1>

    <div class="about-content">
      <Image
        class="portrait"
        src={portrait}
        alt="Kacper Cygan"
        width={224}
        height={224}
        quality={90}
      />

      <div class="prose">
        <p>
          I’m Kacper, nice to meet you. Professionally, I’m a product engineer at
          <AshbyLink />. Outside work, I enjoy fatherhood, reading, and lately,
          writing.
        </p>
        <p>
          I made this website to motivate myself to put more of my thoughts into
          words. <em>By gad, you’re under no obligation to read them!</em>
        </p>
        <p class="links">
          <a href="mailto:hello@kcygan.dev">Email me</a>
          <span aria-hidden="true">·</span>
          <a href="https://github.com/kcvgan" rel="me">GitHub</a>
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .about-page {
    width: min(100% - 3rem, var(--measure));
    margin: 4rem auto 0;
  }

  h1 {
    margin: 0 0 2.5rem;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .about-content {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 2rem;
    align-items: start;
  }

  .portrait {
    width: 7rem;
    height: 7rem;
    border: 1px solid rgb(29 28 25 / 0.4);
    border-radius: 0.35rem;
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.14),
      0 5px 14px rgb(0 0 0 / 0.08);
    object-fit: cover;
    transform: rotate(-1.5deg);
    transition:
      box-shadow 220ms ease,
      transform 220ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .portrait:hover {
    box-shadow:
      0 2px 3px rgb(0 0 0 / 0.12),
      0 8px 18px rgb(0 0 0 / 0.1);
    transform: translateY(-2px) rotate(1.5deg);
  }

  .prose {
    max-width: 34rem;
    font-family: var(--font-serif);
    font-size: 1.18rem;
    line-height: 1.7;
  }

  .prose p {
    margin: 0 0 1.25em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.82rem;
  }

  .links a {
    color: var(--ink);
  }

  @media (max-width: 36rem) {
    .about-page {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 3rem;
    }

    .about-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .portrait {
      width: 5rem;
      height: 5rem;
    }

    .prose {
      font-size: 1.12rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .portrait {
      transition: none;
    }
  }
</style>
