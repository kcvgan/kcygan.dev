---
import PortraitStamp from '../components/PortraitStamp.astro';
import AshbyLink from '../components/AshbyLink.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About"
  description="Meet Kacper Cygan: product engineer at Ashby, enjoying fatherhood, reading, and writing. Building Collie."
>
  <div class="about-page">
    <section class="introduction" aria-labelledby="hello-title">
      <div class="greeting">
        <PortraitStamp />
        <h1 id="hello-title">I’m Kacper, nice to meet you.</h1>
      </div>
      <p>
        Professionally, I’m a product engineer at <AshbyLink />. Outside work,
        I enjoy fatherhood, reading, and lately, writing.
      </p>
      <p>
        I’m building <a href="https://getcollie.cloud">Collie</a>, a text editor
        that works the way I work. <a href="/blog/why-i-built-collie">Why I built Collie</a>.
      </p>
      <p class="links">
        <a href="mailto:kcygan54@gmail.com">Email me</a>
        <span aria-hidden="true">·</span>
        <a href="https://github.com/kcvgan" rel="me">GitHub</a>
      </p>
    </section>
  </div>
</Layout>

<style>
  .about-page {
    width: min(100% - 3rem, var(--measure));
    margin: 4rem auto;
  }

  .introduction {
    font-family: var(--font-serif);
    font-size: 1.18rem;
    line-height: 1.7;
  }

  .greeting {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.75rem;
  }

  h1 {
    margin: 0;
    font-size: clamp(1.65rem, 4vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .introduction p {
    margin: 0 0 1.25em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.82rem;
  }

  @media (max-width: 36rem) {
    .about-page {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 3rem;
    }

    .introduction {
      font-size: 1.12rem;
    }
  }
</style>
