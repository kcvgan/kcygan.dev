---
import booksData from '../data/books.json';
import Layout from '../layouts/Layout.astro';

interface Book {
  id: string;
  title: string;
  author: string;
  cover: string;
  url: string;
  rating: number | null;
  dateRead: string | null;
  dateAdded: string | null;
  yearRead: string | null;
  yearPublished: number | null;
  pages: number | null;
}

const books = booksData as Book[];
const recentYearCutoff = 2020;
const groupFor = (book: Book) =>
  book.yearRead && Number(book.yearRead) >= recentYearCutoff ? book.yearRead : 'Earlier';
const groupNames = [...new Set(books.map(groupFor))].sort((a, b) => {
  if (a === 'Earlier') return 1;
  if (b === 'Earlier') return -1;
  return Number(b) - Number(a);
});
const groups = groupNames.map((name) => ({
  name,
  books: books.filter((book) => groupFor(book) === name),
}));
---

<Layout
  title="Bookshelf"
  description="The books Kacper Cygan has read, collected from Goodreads."
>
  <div class="bookshelf-page" data-bookshelf>
    <header class="bookshelf-intro">
      <h1>Bookshelf</h1>
    </header>

    <div class="bookshelf-tools">
      <label class="book-search">
        <span class="visually-hidden">Find a title or author</span>
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.75"></circle>
          <path d="m13 13 4 4"></path>
        </svg>
        <input type="search" placeholder="Find a title or author" autocomplete="off" data-book-search />
      </label>

      <div class="year-filters" aria-label="Filter books by year">
        <button type="button" aria-pressed="true" data-year-filter="all">All</button>
        {groupNames.map((name) => (
          <button type="button" aria-pressed="false" data-year-filter={name}>{name}</button>
        ))}
      </div>
    </div>

    <div class="shelf-collection">
      {groups.map((group) => (
        <section class="year-shelf" data-year-section={group.name}>
          <header class="year-heading">
            <h2>{group.name}</h2>
            <span data-year-count>{group.books.length}</span>
          </header>

          <ol class="book-grid">
            {group.books.map((book) => (
              <li
                class="book-slot"
                data-book-slot
                data-year={group.name}
                data-search={`${book.title} ${book.author}`}
              >
                <a
                  class="book-card"
                  href={book.url}
                  aria-label={`${book.title} by ${book.author}`}
                  data-book-card
                  data-title={book.title}
                  data-author={book.author}
                  data-cover={book.cover}
                  data-url={book.url}
                  data-rating={book.rating ?? ''}
                  data-date-read={book.dateRead ?? ''}
                >
                  <span class="book-jacket">
                    <img
                      src={book.cover}
                      alt=""
                      width="240"
                      height="360"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                    <span class="book-peek" aria-hidden="true">
                      <strong>{book.title}</strong>
                      <span>{book.author}</span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <p class="no-results" hidden data-no-results>
        No books found. Try another title, author, or year.
      </p>
    </div>

    <dialog class="book-dialog" data-book-dialog aria-labelledby="book-dialog-title" tabindex="-1">
      <div class="dialog-layout">
        <form>
          <button
            class="dialog-close"
            type="button"
            aria-label="Close book details"
            data-dialog-close
          >
            ×
          </button>
        </form>
        <div class="dialog-cover-wrap">
          <img data-dialog-cover src="" alt="" />
        </div>
        <div class="dialog-copy">
          <p class="dialog-kicker" data-dialog-read></p>
          <h2 id="book-dialog-title" data-dialog-title></h2>
          <p class="dialog-author" data-dialog-author></p>
          <p class="dialog-rating" data-dialog-rating></p>
          <a class="goodreads-link" data-dialog-link href="" rel="noreferrer">
            View on Goodreads <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </dialog>
  </div>
</Layout>

<script>
  const bookshelf = document.querySelector('[data-bookshelf]');

  if (bookshelf) {
    const search = bookshelf.querySelector<HTMLInputElement>('[data-book-search]');
    const filters = [...bookshelf.querySelectorAll<HTMLButtonElement>('[data-year-filter]')];
    const slots = [...bookshelf.querySelectorAll<HTMLElement>('[data-book-slot]')];
    const sections = [...bookshelf.querySelectorAll<HTMLElement>('[data-year-section]')];
    const noResults = bookshelf.querySelector<HTMLElement>('[data-no-results]');
    const dialog = bookshelf.querySelector<HTMLDialogElement>('[data-book-dialog]');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-dialog-close]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeYear = 'all';
    let closeTimer: number | undefined;
    let activeSourceCard: HTMLAnchorElement | undefined;

    const applyFilters = () => {
      const query = search?.value.trim().toLocaleLowerCase() ?? '';
      let count = 0;

      for (const slot of slots) {
        const matchesYear = activeYear === 'all' || slot.dataset.year === activeYear;
        const matchesSearch = !query || slot.dataset.search?.toLocaleLowerCase().includes(query);
        slot.hidden = !(matchesYear && matchesSearch);
        if (!slot.hidden) count += 1;
      }

      for (const section of sections) {
        const visibleBooks = [...section.querySelectorAll<HTMLElement>('[data-book-slot]')].filter(
          (slot) => !slot.hidden,
        );
        section.hidden = visibleBooks.length === 0;
        const sectionCount = section.querySelector<HTMLElement>('[data-year-count]');
        if (sectionCount) sectionCount.textContent = String(visibleBooks.length);
      }

      if (noResults) noResults.hidden = count !== 0;
    };

    search?.addEventListener('input', applyFilters);

    for (const filter of filters) {
      filter.addEventListener('click', () => {
        activeYear = filter.dataset.yearFilter ?? 'all';
        for (const button of filters) {
          button.setAttribute('aria-pressed', String(button === filter));
        }
        applyFilters();
      });
    }

    const formatReadDate = (dateValue: string) => {
      if (!dateValue) return 'Date read not recorded';
      const date = new Date(`${dateValue}T00:00:00Z`);
      return `Read ${new Intl.DateTimeFormat('en', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(date)}`;
    };

    const openFocus = (card: HTMLAnchorElement) => {
      if (!dialog) return;
      if (closeTimer) window.clearTimeout(closeTimer);

      const source = card.querySelector<HTMLElement>('.book-jacket');
      const target = dialog.querySelector<HTMLElement>('.dialog-cover-wrap');
      const sourceRect = source?.getBoundingClientRect();

      dialog.classList.remove('is-visible');
      dialog.classList.add('is-measuring');
      if (!dialog.open) dialog.showModal();
      dialog.focus({ preventScroll: true });

      if (reducedMotion) {
        dialog.classList.remove('is-measuring');
        activeSourceCard?.classList.remove('is-focus-source');
        activeSourceCard = card;
        activeSourceCard.classList.add('is-focus-source');
        dialog.classList.add('is-visible');
        return;
      }

      window.requestAnimationFrame(() => {
        dialog.classList.add('is-visible');

        if (sourceRect && target) {
          const targetRect = target.getBoundingClientRect();
          const sourceCenterX = sourceRect.left + sourceRect.width / 2;
          const sourceCenterY = sourceRect.top + sourceRect.height / 2;
          const targetCenterX = targetRect.left + targetRect.width / 2;
          const targetCenterY = targetRect.top + targetRect.height / 2;

          dialog.style.setProperty('--cover-from-x', `${sourceCenterX - targetCenterX}px`);
          dialog.style.setProperty('--cover-from-y', `${sourceCenterY - targetCenterY}px`);
          dialog.style.setProperty('--cover-from-scale-x', `${sourceRect.width / targetRect.width}`);
          dialog.style.setProperty('--cover-from-scale-y', `${sourceRect.height / targetRect.height}`);
        }

        dialog.classList.remove('is-visible', 'is-measuring');
        dialog.getBoundingClientRect();
        activeSourceCard?.classList.remove('is-focus-source');
        activeSourceCard = card;
        activeSourceCard.classList.add('is-focus-source');

        window.requestAnimationFrame(() => dialog.classList.add('is-visible'));
      });
    };

    const closeFocus = () => {
      if (!dialog?.open) return;
      dialog.classList.remove('is-visible');

      if (reducedMotion) {
        dialog.close();
        return;
      }

      closeTimer = window.setTimeout(() => dialog.close(), 260);
    };

    for (const card of bookshelf.querySelectorAll<HTMLAnchorElement>('[data-book-card]')) {
      card.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !dialog) return;
        event.preventDefault();

        const cover = dialog.querySelector<HTMLImageElement>('[data-dialog-cover]');
        const title = dialog.querySelector<HTMLElement>('[data-dialog-title]');
        const author = dialog.querySelector<HTMLElement>('[data-dialog-author]');
        const read = dialog.querySelector<HTMLElement>('[data-dialog-read]');
        const rating = dialog.querySelector<HTMLElement>('[data-dialog-rating]');
        const link = dialog.querySelector<HTMLAnchorElement>('[data-dialog-link]');
        const sourceCover = card.querySelector<HTMLImageElement>('.book-jacket img');

        if (cover) {
          cover.src = card.dataset.cover ?? '';
          cover.alt = `Cover of ${card.dataset.title ?? 'book'}`;
          cover.width = sourceCover?.naturalWidth || sourceCover?.width || 240;
          cover.height = sourceCover?.naturalHeight || sourceCover?.height || 360;
        }
        if (title) title.textContent = card.dataset.title ?? '';
        if (author) author.textContent = card.dataset.author ?? '';
        if (read) read.textContent = formatReadDate(card.dataset.dateRead ?? '');
        if (link) link.href = card.dataset.url ?? card.href;

        const bookRating = Number(card.dataset.rating);
        if (rating) {
          rating.hidden = !bookRating;
          rating.textContent = bookRating ? `${'★'.repeat(bookRating)}${'☆'.repeat(5 - bookRating)}` : '';
          rating.setAttribute('aria-label', bookRating ? `${bookRating} out of 5 stars` : 'Not rated');
        }

        openFocus(card);
      });

      if (!reducedMotion) {
        card.addEventListener('mousemove', (event) => {
          const rect = card.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          card.style.setProperty('--tilt-x', `${(-y * 5).toFixed(2)}deg`);
          card.style.setProperty('--tilt-y', `${(x * 7).toFixed(2)}deg`);
          card.style.setProperty('--shine-x', `${((x + 0.5) * 100).toFixed(0)}%`);
        });
        card.addEventListener('mouseleave', () => {
          card.style.removeProperty('--tilt-x');
          card.style.removeProperty('--tilt-y');
          card.style.removeProperty('--shine-x');
        });
      }
    }

    closeButton?.addEventListener('click', closeFocus);

    dialog?.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.classList.contains('dialog-layout')) closeFocus();
    });

    dialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeFocus();
    });

    dialog?.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      event.preventDefault();
      closeFocus();
    });

    dialog?.addEventListener('close', () => {
      if (closeTimer) window.clearTimeout(closeTimer);
      closeTimer = undefined;
      activeSourceCard?.classList.remove('is-focus-source');
      activeSourceCard = undefined;
      dialog.classList.remove('is-visible', 'is-measuring');
    });
  }
</script>

<style>
  .bookshelf-page {
    margin: 4rem auto 6rem;
  }

  .bookshelf-intro,
  .bookshelf-tools,
  .shelf-collection {
    width: min(100% - 3rem, 64rem);
    margin-inline: auto;
  }

  .bookshelf-intro {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  h1,
  h2 {
    font-family: var(--font-serif);
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .bookshelf-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .book-search {
    display: flex;
    flex: 0 1 18rem;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--rule);
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--paper) 72%, white);
  }

  .book-search:focus-within {
    border-color: var(--muted);
    outline: 1px solid var(--muted);
    outline-offset: 2px;
  }

  .book-search svg {
    flex: 0 0 auto;
    width: 0.9rem;
    fill: none;
    stroke: var(--muted);
    stroke-linecap: round;
    stroke-width: 1.5;
  }

  .book-search input {
    width: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.78rem;
  }

  .book-search input::placeholder {
    color: var(--muted);
    opacity: 0.85;
  }

  .year-filters {
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    padding-block: 0.25rem;
    scrollbar-width: none;
  }

  .year-filters::-webkit-scrollbar {
    display: none;
  }

  .year-filters button {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.75rem;
    text-decoration-color: transparent;
    text-underline-offset: 0.35em;
    white-space: nowrap;
  }

  .year-filters button:hover,
  .year-filters button[aria-pressed='true'] {
    color: var(--ink);
  }

  .year-filters button[aria-pressed='true'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .year-filters button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .shelf-collection {
    margin-top: 3.75rem;
  }

  .year-shelf {
    margin-bottom: 4.5rem;
  }

  .year-heading {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 1.35rem;
  }

  .year-heading h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .year-heading span {
    color: var(--muted);
    font-size: 0.7rem;
  }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1.55rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book-slot {
    position: relative;
    display: grid;
    place-items: end center;
    min-width: 0;
    height: 12.75rem;
    padding: 0 0.35rem 0.8rem;
  }

  .book-slot::after {
    content: '';
    position: absolute;
    right: -0.5rem;
    bottom: 0.3rem;
    left: -0.5rem;
    height: 1px;
    background: var(--rule);
    box-shadow: 0 4px 0 var(--paper-deep);
  }

  .book-card {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(100%, 7.35rem);
    color: inherit;
    perspective: 700px;
    text-decoration: none;
  }

  .book-jacket {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    width: 100%;
    border-radius: 0.16rem 0.28rem 0.28rem 0.16rem;
    background: var(--paper-deep);
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transform-origin: center bottom;
    box-shadow:
      -2px 2px 0 color-mix(in srgb, var(--ink) 20%, transparent),
      0 7px 13px rgb(29 28 25 / 0.14),
      0 2px 3px rgb(29 28 25 / 0.15);
    transition:
      box-shadow 220ms ease,
      transform 240ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .book-jacket::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 28%,
      rgb(255 255 255 / 0.16) var(--shine-x, 52%),
      transparent 72%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .book-jacket img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-card.is-focus-source .book-jacket {
    opacity: 0;
    transition: none;
  }

  .book-peek {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 0.08rem;
    padding: 2.8rem 0.55rem 0.48rem;
    background: linear-gradient(transparent, rgb(17 17 15 / 0.92));
    color: #fff;
    opacity: 0;
    transform: translateY(0.3rem);
    transition:
      opacity 180ms ease,
      transform 220ms ease;
  }

  .book-peek strong,
  .book-peek span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .book-peek strong {
    font-family: var(--font-serif);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .book-peek span {
    color: rgb(255 255 255 / 0.76);
    font-size: 0.54rem;
  }

  .book-card:hover .book-jacket,
  .book-card:focus-visible .book-jacket {
    transform: translateY(-0.4rem) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    box-shadow:
      -2px 2px 0 color-mix(in srgb, var(--ink) 18%, transparent),
      0 14px 23px rgb(29 28 25 / 0.18),
      0 4px 7px rgb(29 28 25 / 0.14);
  }

  .book-card:hover .book-jacket::after,
  .book-card:focus-visible .book-jacket::after,
  .book-card:hover .book-peek,
  .book-card:focus-visible .book-peek {
    opacity: 1;
  }

  .book-card:hover .book-peek,
  .book-card:focus-visible .book-peek {
    transform: translateY(0);
  }

  .book-card:focus-visible {
    outline: 0;
  }

  .book-card:focus-visible .book-jacket {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .no-results {
    padding-block: 4rem;
    border-block: 1px solid var(--rule);
    color: var(--muted);
    font-family: var(--font-serif);
    text-align: center;
  }

  .book-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: transparent;
    color: #f8f5ec;
    outline: none;
  }

  .book-dialog::backdrop {
    background: transparent;
    backdrop-filter: blur(0);
    transition:
      background 180ms ease,
      backdrop-filter 180ms ease;
  }

  .book-dialog.is-visible::backdrop {
    background: rgb(17 17 15 / 0.5);
    backdrop-filter: blur(8px);
  }

  .book-dialog.is-measuring::backdrop {
    background: transparent;
    backdrop-filter: blur(0);
    transition: none;
  }

  .dialog-close {
    position: absolute;
    z-index: 3;
    top: 1.25rem;
    right: 1.25rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: 50%;
    background: rgb(17 17 15 / 0.24);
    color: #fff;
    cursor: pointer;
    font: inherit;
    font-size: 1.3rem;
    line-height: 1;
    opacity: 0;
    pointer-events: auto;
    transform: scale(0.82);
    transition:
      opacity 140ms ease 90ms,
      transform 180ms cubic-bezier(0.2, 0.8, 0.2, 1) 70ms;
  }

  .book-dialog.is-visible .dialog-close {
    opacity: 1;
    transform: scale(1);
  }

  .dialog-close:hover {
    border-color: rgb(255 255 255 / 0.7);
    background: rgb(17 17 15 / 0.4);
  }

  .dialog-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .dialog-layout {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    overflow: visible;
    border: 0;
    background: transparent;
    box-shadow: none;
    outline: none;
    transition: none;
  }

  .dialog-layout > form {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .dialog-cover-wrap {
    position: absolute;
    z-index: 1;
    top: 50%;
    left: 50%;
    width: clamp(15rem, 22.5vw, 18rem);
    opacity: 0.88;
    filter: blur(3px);
    transform: translate(-50%, -50%) translate(var(--cover-from-x, 0), var(--cover-from-y, 0))
      scale(var(--cover-from-scale-x, 0.86), var(--cover-from-scale-y, 0.86));
    transform-origin: center;
    transition:
      opacity 190ms ease,
      filter 230ms ease,
      transform 240ms cubic-bezier(0.2, 0.82, 0.2, 1);
  }

  .book-dialog.is-visible .dialog-cover-wrap {
    opacity: 1;
    filter: blur(0);
    transform: translate(-50%, -50%) scale(1);
  }

  .book-dialog.is-measuring .dialog-cover-wrap {
    opacity: 0;
    filter: none;
    transform: translate(-50%, -50%);
    transition: none;
  }

  .dialog-cover-wrap img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 72dvh;
    border-radius: 0.2rem;
    object-fit: contain;
    box-shadow:
      -3px 3px 0 rgb(255 255 255 / 0.18),
      0 22px 55px rgb(0 0 0 / 0.44);
  }

  .dialog-copy {
    position: absolute;
    top: 50%;
    left: calc(50% + clamp(10rem, 17vw, 12rem));
    width: min(19rem, calc(50vw - 13rem));
    opacity: 0;
    transform: translateY(-50%) translateX(0.8rem);
    transition:
      opacity 150ms ease 60ms,
      transform 190ms cubic-bezier(0.2, 0.8, 0.2, 1) 45ms;
  }

  .book-dialog.is-visible .dialog-copy {
    opacity: 1;
    transform: translateY(-50%) translateX(0);
  }

  .book-dialog.is-measuring .dialog-copy,
  .book-dialog.is-measuring .dialog-close {
    opacity: 0;
    transition: none;
  }

  .dialog-kicker {
    margin: 0 0 0.65rem;
    color: rgb(255 255 255 / 0.58);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .dialog-copy h2 {
    margin: 0;
    font-size: clamp(1.65rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
    color: #fff;
