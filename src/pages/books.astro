---
import booksData from '../data/books.json';
import Layout from '../layouts/Layout.astro';

interface Book {
  id: string;
  title: string;
  author: string;
  cover: string;
  url: string;
  rating: number | null;
  dateRead: string | null;
  dateAdded: string | null;
  yearRead: string | null;
  yearPublished: number | null;
  pages: number | null;
}

const books = booksData as Book[];
const recentYearCutoff = 2020;
const groupFor = (book: Book) =>
  book.yearRead && Number(book.yearRead) >= recentYearCutoff ? book.yearRead : 'Earlier';
const groupNames = [...new Set(books.map(groupFor))].sort((a, b) => {
  if (a === 'Earlier') return 1;
  if (b === 'Earlier') return -1;
  return Number(b) - Number(a);
});
const groups = groupNames.map((name) => ({
  name,
  books: books.filter((book) => groupFor(book) === name),
}));
---

<Layout
  title="Bookshelf"
  description="The books Kacper Cygan has read, collected from Goodreads."
>
  <div class="bookshelf-page" data-bookshelf>
    <header class="bookshelf-intro">
      <h1>Bookshelf</h1>
    </header>

    <div class="bookshelf-tools">
      <label class="book-search">
        <span class="visually-hidden">Find a title or author</span>
        <svg viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="8.5" cy="8.5" r="5.75"></circle>
          <path d="m13 13 4 4"></path>
        </svg>
        <input type="search" placeholder="Find a title or author" autocomplete="off" data-book-search />
      </label>

      <div class="year-filters" aria-label="Filter books by year">
        <button type="button" aria-pressed="true" data-year-filter="all">All</button>
        {groupNames.map((name) => (
          <button type="button" aria-pressed="false" data-year-filter={name}>{name}</button>
        ))}
      </div>
    </div>

    <div class="shelf-collection">
      {groups.map((group) => (
        <section class="year-shelf" data-year-section={group.name}>
          <header class="year-heading">
            <h2>{group.name}</h2>
            <span data-year-count>{group.books.length}</span>
          </header>

          <ol class="book-grid">
            {group.books.map((book) => (
              <li
                class="book-slot"
                data-book-slot
                data-year={group.name}
                data-search={`${book.title} ${book.author}`}
              >
                <a
                  class="book-card"
                  href={book.url}
                  aria-label={`${book.title} by ${book.author}`}
                  data-book-card
                  data-title={book.title}
                  data-author={book.author}
                  data-cover={book.cover}
                  data-url={book.url}
                  data-rating={book.rating ?? ''}
                  data-date-read={book.dateRead ?? ''}
                >
                  <span class="book-jacket">
                    <img
                      src={book.cover}
                      alt=""
                      width="240"
                      height="360"
                      loading="lazy"
                      decoding="async"
                      referrerpolicy="no-referrer"
                    />
                    <span class="book-peek" aria-hidden="true">
                      <strong>{book.title}</strong>
                      <span>{book.author}</span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <p class="no-results" hidden data-no-results>
        No books found. Try another title, author, or year.
      </p>
    </div>

    <dialog class="book-dialog" data-book-dialog aria-labelledby="book-dialog-title">
      <form>
        <button class="dialog-close" type="button" aria-label="Close book details" data-dialog-close>
          ×
        </button>
      </form>
      <div class="dialog-layout">
        <div class="dialog-cover-wrap">
          <img data-dialog-cover src="" alt="" />
        </div>
        <div class="dialog-copy">
          <p class="dialog-kicker" data-dialog-read></p>
          <h2 id="book-dialog-title" data-dialog-title></h2>
          <p class="dialog-author" data-dialog-author></p>
          <p class="dialog-rating" data-dialog-rating></p>
          <a class="goodreads-link" data-dialog-link href="" rel="noreferrer">
            View on Goodreads <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </dialog>
  </div>
</Layout>

<script>
  const bookshelf = document.querySelector('[data-bookshelf]');

  if (bookshelf) {
    const search = bookshelf.querySelector<HTMLInputElement>('[data-book-search]');
    const filters = [...bookshelf.querySelectorAll<HTMLButtonElement>('[data-year-filter]')];
    const slots = [...bookshelf.querySelectorAll<HTMLElement>('[data-book-slot]')];
    const sections = [...bookshelf.querySelectorAll<HTMLElement>('[data-year-section]')];
    const noResults = bookshelf.querySelector<HTMLElement>('[data-no-results]');
    const dialog = bookshelf.querySelector<HTMLDialogElement>('[data-book-dialog]');
    const closeButton = dialog?.querySelector<HTMLButtonElement>('[data-dialog-close]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let activeYear = 'all';
    let closeTimer: number | undefined;

    const applyFilters = () => {
      const query = search?.value.trim().toLocaleLowerCase() ?? '';
      let count = 0;

      for (const slot of slots) {
        const matchesYear = activeYear === 'all' || slot.dataset.year === activeYear;
        const matchesSearch = !query || slot.dataset.search?.toLocaleLowerCase().includes(query);
        slot.hidden = !(matchesYear && matchesSearch);
        if (!slot.hidden) count += 1;
      }

      for (const section of sections) {
        const visibleBooks = [...section.querySelectorAll<HTMLElement>('[data-book-slot]')].filter(
          (slot) => !slot.hidden,
        );
        section.hidden = visibleBooks.length === 0;
        const sectionCount = section.querySelector<HTMLElement>('[data-year-count]');
        if (sectionCount) sectionCount.textContent = String(visibleBooks.length);
      }

      if (noResults) noResults.hidden = count !== 0;
    };

    search?.addEventListener('input', applyFilters);

    for (const filter of filters) {
      filter.addEventListener('click', () => {
        activeYear = filter.dataset.yearFilter ?? 'all';
        for (const button of filters) {
          button.setAttribute('aria-pressed', String(button === filter));
        }
        applyFilters();
      });
    }

    const formatReadDate = (dateValue: string) => {
      if (!dateValue) return 'Date read not recorded';
      const date = new Date(`${dateValue}T00:00:00Z`);
      return `Read ${new Intl.DateTimeFormat('en', {
        month: 'long',
        year: 'numeric',
        timeZone: 'UTC',
      }).format(date)}`;
    };

    const openSheet = () => {
      if (!dialog) return;
      if (closeTimer) window.clearTimeout(closeTimer);
      if (!dialog.open) dialog.showModal();

      if (reducedMotion) {
        dialog.classList.add('is-visible');
        return;
      }

      window.requestAnimationFrame(() => {
        window.requestAnimationFrame(() => dialog.classList.add('is-visible'));
      });
    };

    const closeSheet = () => {
      if (!dialog?.open) return;
      dialog.classList.remove('is-visible');

      if (reducedMotion) {
        dialog.close();
        return;
      }

      closeTimer = window.setTimeout(() => dialog.close(), 430);
    };

    for (const card of bookshelf.querySelectorAll<HTMLAnchorElement>('[data-book-card]')) {
      card.addEventListener('click', (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !dialog) return;
        event.preventDefault();

        const cover = dialog.querySelector<HTMLImageElement>('[data-dialog-cover]');
        const title = dialog.querySelector<HTMLElement>('[data-dialog-title]');
        const author = dialog.querySelector<HTMLElement>('[data-dialog-author]');
        const read = dialog.querySelector<HTMLElement>('[data-dialog-read]');
        const rating = dialog.querySelector<HTMLElement>('[data-dialog-rating]');
        const link = dialog.querySelector<HTMLAnchorElement>('[data-dialog-link]');

        if (cover) {
          cover.src = card.dataset.cover ?? '';
          cover.alt = `Cover of ${card.dataset.title ?? 'book'}`;
        }
        if (title) title.textContent = card.dataset.title ?? '';
        if (author) author.textContent = card.dataset.author ?? '';
        if (read) read.textContent = formatReadDate(card.dataset.dateRead ?? '');
        if (link) link.href = card.dataset.url ?? card.href;

        const bookRating = Number(card.dataset.rating);
        if (rating) {
          rating.hidden = !bookRating;
          rating.textContent = bookRating ? `${'★'.repeat(bookRating)}${'☆'.repeat(5 - bookRating)}` : '';
          rating.setAttribute('aria-label', bookRating ? `${bookRating} out of 5 stars` : 'Not rated');
        }

        openSheet();
      });

      if (!reducedMotion) {
        card.addEventListener('mousemove', (event) => {
          const rect = card.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          card.style.setProperty('--tilt-x', `${(-y * 5).toFixed(2)}deg`);
          card.style.setProperty('--tilt-y', `${(x * 7).toFixed(2)}deg`);
          card.style.setProperty('--shine-x', `${((x + 0.5) * 100).toFixed(0)}%`);
        });
        card.addEventListener('mouseleave', () => {
          card.style.removeProperty('--tilt-x');
          card.style.removeProperty('--tilt-y');
          card.style.removeProperty('--shine-x');
        });
      }
    }

    closeButton?.addEventListener('click', closeSheet);

    dialog?.addEventListener('click', (event) => {
      if (event.target === dialog) closeSheet();
    });

    dialog?.addEventListener('cancel', (event) => {
      event.preventDefault();
      closeSheet();
    });

    dialog?.addEventListener('close', () => {
      if (closeTimer) window.clearTimeout(closeTimer);
      closeTimer = undefined;
      dialog.classList.remove('is-visible');
    });
  }
</script>

<style>
  .bookshelf-page {
    margin: 4rem auto 6rem;
  }

  .bookshelf-intro,
  .bookshelf-tools,
  .shelf-collection {
    width: min(100% - 3rem, 64rem);
    margin-inline: auto;
  }

  .bookshelf-intro {
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--rule);
  }

  h1,
  h2 {
    font-family: var(--font-serif);
  }

  h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .bookshelf-tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .book-search {
    display: flex;
    flex: 0 1 18rem;
    align-items: center;
    gap: 0.55rem;
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--rule);
    border-radius: 0.35rem;
    background: color-mix(in srgb, var(--paper) 72%, white);
  }

  .book-search:focus-within {
    border-color: var(--muted);
    outline: 1px solid var(--muted);
    outline-offset: 2px;
  }

  .book-search svg {
    flex: 0 0 auto;
    width: 0.9rem;
    fill: none;
    stroke: var(--muted);
    stroke-linecap: round;
    stroke-width: 1.5;
  }

  .book-search input {
    width: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.78rem;
  }

  .book-search input::placeholder {
    color: var(--muted);
    opacity: 0.85;
  }

  .year-filters {
    display: flex;
    gap: 0.9rem;
    overflow-x: auto;
    padding-block: 0.25rem;
    scrollbar-width: none;
  }

  .year-filters::-webkit-scrollbar {
    display: none;
  }

  .year-filters button {
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    font: inherit;
    font-size: 0.75rem;
    text-decoration-color: transparent;
    text-underline-offset: 0.35em;
    white-space: nowrap;
  }

  .year-filters button:hover,
  .year-filters button[aria-pressed='true'] {
    color: var(--ink);
  }

  .year-filters button[aria-pressed='true'] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .year-filters button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .shelf-collection {
    margin-top: 3.75rem;
  }

  .year-shelf {
    margin-bottom: 4.5rem;
  }

  .year-heading {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    margin-bottom: 1.35rem;
  }

  .year-heading h2 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .year-heading span {
    color: var(--muted);
    font-size: 0.7rem;
  }

  .book-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 1.55rem 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .book-slot {
    position: relative;
    display: grid;
    place-items: end center;
    min-width: 0;
    height: 12.75rem;
    padding: 0 0.35rem 0.8rem;
  }

  .book-slot::after {
    content: '';
    position: absolute;
    right: -0.5rem;
    bottom: 0.3rem;
    left: -0.5rem;
    height: 1px;
    background: var(--rule);
    box-shadow: 0 4px 0 var(--paper-deep);
  }

  .book-card {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(100%, 7.35rem);
    color: inherit;
    perspective: 700px;
    text-decoration: none;
  }

  .book-jacket {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 2 / 3;
    width: 100%;
    border-radius: 0.16rem 0.28rem 0.28rem 0.16rem;
    background: var(--paper-deep);
    transform: rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    transform-origin: center bottom;
    box-shadow:
      -2px 2px 0 color-mix(in srgb, var(--ink) 20%, transparent),
      0 7px 13px rgb(29 28 25 / 0.14),
      0 2px 3px rgb(29 28 25 / 0.15);
    transition:
      box-shadow 220ms ease,
      transform 240ms cubic-bezier(0.2, 0.75, 0.2, 1);
  }

  .book-jacket::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      105deg,
      transparent 28%,
      rgb(255 255 255 / 0.16) var(--shine-x, 52%),
      transparent 72%
    );
    opacity: 0;
    pointer-events: none;
    transition: opacity 180ms ease;
  }

  .book-jacket img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book-peek {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: grid;
    gap: 0.08rem;
    padding: 2.8rem 0.55rem 0.48rem;
    background: linear-gradient(transparent, rgb(17 17 15 / 0.92));
    color: #fff;
    opacity: 0;
    transform: translateY(0.3rem);
    transition:
      opacity 180ms ease,
      transform 220ms ease;
  }

  .book-peek strong,
  .book-peek span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .book-peek strong {
    font-family: var(--font-serif);
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .book-peek span {
    color: rgb(255 255 255 / 0.76);
    font-size: 0.54rem;
  }

  .book-card:hover .book-jacket,
  .book-card:focus-visible .book-jacket {
    transform: translateY(-0.4rem) rotateX(var(--tilt-x, 0deg)) rotateY(var(--tilt-y, 0deg));
    box-shadow:
      -2px 2px 0 color-mix(in srgb, var(--ink) 18%, transparent),
      0 14px 23px rgb(29 28 25 / 0.18),
      0 4px 7px rgb(29 28 25 / 0.14);
  }

  .book-card:hover .book-jacket::after,
  .book-card:focus-visible .book-jacket::after,
  .book-card:hover .book-peek,
  .book-card:focus-visible .book-peek {
    opacity: 1;
  }

  .book-card:hover .book-peek,
  .book-card:focus-visible .book-peek {
    transform: translateY(0);
  }

  .book-card:focus-visible {
    outline: 0;
  }

  .book-card:focus-visible .book-jacket {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .no-results {
    padding-block: 4rem;
    border-block: 1px solid var(--rule);
    color: var(--muted);
    font-family: var(--font-serif);
    text-align: center;
  }

  .book-dialog {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(32rem, calc(100% - 1rem));
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    border: 0;
    border-left: 1px solid color-mix(in srgb, var(--ink) 28%, transparent);
    border-radius: 0.85rem 0 0 0.85rem;
    background: var(--paper);
    color: var(--ink);
    opacity: 0;
    transform: translateX(100%);
    box-shadow: -18px 0 50px rgb(29 28 25 / 0.2);
    transition:
      opacity 220ms ease,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .book-dialog[open].is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  .book-dialog::backdrop {
    background: transparent;
    backdrop-filter: blur(0);
    transition:
      background 300ms ease,
      backdrop-filter 300ms ease;
  }

  .book-dialog.is-visible::backdrop {
    background: rgb(17 17 15 / 0.38);
    backdrop-filter: blur(3px);
  }

  .dialog-close {
    position: absolute;
    z-index: 2;
    top: 0.7rem;
    right: 0.7rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    color: var(--ink);
    cursor: pointer;
    font: inherit;
    font-size: 1.3rem;
    line-height: 1;
  }

  .dialog-close:hover {
    border-color: var(--muted);
  }

  .dialog-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .dialog-layout {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    gap: 2rem;
    padding: 4rem 2.75rem 3rem;
  }

  .dialog-cover-wrap {
    width: min(100%, 18rem);
    margin-inline: auto;
    opacity: 0;
    filter: blur(8px);
    transform: translateX(2.5rem) scale(0.94) rotate(1.5deg);
    transition:
      opacity 280ms ease 70ms,
      filter 420ms ease 70ms,
      transform 520ms cubic-bezier(0.22, 1, 0.36, 1) 50ms;
  }

  .book-dialog.is-visible .dialog-cover-wrap {
    opacity: 1;
    filter: blur(0);
    transform: translateX(0) scale(1) rotate(-0.8deg);
  }

  .dialog-cover-wrap img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 56dvh;
    border-radius: 0.2rem;
    object-fit: contain;
    box-shadow:
      -3px 3px 0 color-mix(in srgb, var(--ink) 18%, transparent),
      0 13px 28px rgb(29 28 25 / 0.2);
  }

  .dialog-copy {
    opacity: 0;
    transform: translateX(1.25rem);
    transition:
      opacity 300ms ease 150ms,
      transform 440ms cubic-bezier(0.22, 1, 0.36, 1) 130ms;
  }

  .book-dialog.is-visible .dialog-copy {
    opacity: 1;
    transform: translateX(0);
  }

  .dialog-kicker {
    margin: 0 0 0.65rem;
    color: var(--muted);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .dialog-copy h2 {
    margin: 0;
    font-size: clamp(1.65rem, 4vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .dialog-author {
    margin: 0.65rem 0 0;
    color: var(--muted);
    font-family: var(--font-serif);
    font-size: 1.05rem;
  }

  .dialog-rating {
    margin: 1.25rem 0 0;
    color: var(--accent);
    font-size: 0.9rem;
    letter-spacing: 0.13em;
  }

  .goodreads-link {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 0.78rem;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 68rem) {
    .book-grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }

  @media (max-width: 56rem) {
    .book-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (max-width: 43rem) {
    .book-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .bookshelf-tools {
      align-items: stretch;
      flex-direction: column;
      gap: 0.8rem;
    }

    .book-search {
      flex-basis: auto;
    }

    .year-filters {
      margin-inline: -0.2rem;
      padding: 0.25rem 0.2rem 0.45rem;
    }
  }

  @media (max-width: 36rem) {
    .bookshelf-page {
      margin-top: 3rem;
    }

    .bookshelf-intro,
    .bookshelf-tools,
    .shelf-collection {
      width: min(100% - 2.5rem, 64rem);
    }

    .shelf-collection {
      margin-top: 2.75rem;
    }

    .year-shelf {
      margin-bottom: 3.75rem;
    }

    .book-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1.2rem 0.7rem;
    }

    .book-slot {
      height: 10.5rem;
      padding-inline: 0.2rem;
    }

    .book-card {
      width: min(100%, 6.15rem);
    }

    .book-peek {
      display: none;
    }

    .book-dialog {
      inset: auto 0 0;
      width: 100%;
      height: auto;
      max-height: 88dvh;
      border: 0;
      border-top: 1px solid color-mix(in srgb, var(--ink) 28%, transparent);
      border-radius: 1rem 1rem 0 0;
      transform: translateY(100%);
    }

    .book-dialog[open].is-visible {
      transform: translateY(0);
    }

    .dialog-layout {
      display: grid;
      min-height: 0;
      grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
      gap: 1.4rem;
      align-items: start;
      padding: 3.75rem 1.25rem 2rem;
    }

    .dialog-cover-wrap {
      width: 100%;
      margin: 0;
      transform: translateY(1.5rem) scale(0.94) rotate(1.5deg);
    }

