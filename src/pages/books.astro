---
import booksData from '../data/books.json';
import currentlyReadingData from '../data/currently-reading.json';
import Layout from '../layouts/Layout.astro';

interface Book {
  id: string;
  title: string;
  author: string;
  url: string;
  rating: number | null;
  yearRead: string | null;
}

const books = booksData as Book[];
const currentlyReading = currentlyReadingData as Book[];
const recentYearCutoff = 2020;
const groupFor = (book: Book) =>
  book.yearRead && Number(book.yearRead) >= recentYearCutoff ? book.yearRead : 'Earlier';
const groupNames = [...new Set(books.map(groupFor))].sort((a, b) => {
  if (a === 'Earlier') return 1;
  if (b === 'Earlier') return -1;
  return Number(b) - Number(a);
});
const groups = [
  ...(currentlyReading.length > 0
    ? [{ name: 'Currently reading', books: currentlyReading }]
    : []),
  ...groupNames.map((name) => ({
    name,
    books: books.filter((book) => groupFor(book) === name),
  })),
];
---

<Layout
  title="Reading"
  description="Books Kacper Cygan has read, synced from Goodreads."
>
  <div class="bookshelf">
    <h1>Reading</h1>

    {groups.map((group) => (
      <section>
        <h2>{group.name}</h2>
        <ol>
          {group.books.map((book) => (
            <li>
              <a href={book.url} rel="noreferrer">
                <span class="book">
                  <strong>{book.title}</strong> <em>{book.author}</em>
                </span>
                {book.rating && (
                  <span class="rating" role="img" aria-label={`Rated ${book.rating} out of 5`}>
                    {'★'.repeat(book.rating)}
                  </span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</Layout>

<style>
  .bookshelf {
    width: min(100% - 3rem, var(--measure));
    margin: 4rem auto;
    font-family: var(--font-serif);
  }

  h1 {
    margin: 0 0 2.5rem;
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  section + section {
    margin-top: 2.5rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--rule);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.38rem;
    font-size: 1.05rem;
    line-height: 1.45;
    text-decoration: none;
  }

  strong {
    font-weight: 600;
  }

  em {
    color: var(--muted);
  }

  a:hover strong {
    color: var(--accent);
  }

  .rating {
    flex-shrink: 0;
    color: var(--accent);
    font-family: var(--font-sans);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
  }

  @media (max-width: 36rem) {
    .bookshelf {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 3rem;
    }

    a {
      font-size: 1rem;
    }
  }
</style>
