---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Home" description="Kacper Cygan — frontend developer">
  <div class="landing">
    <div class="container">
      <img class="avatar" src="/images/avatar.JPG" alt="A portrait of Kacper Cygan." />
      <h1>kacper cygan</h1>
      <p class="subtitle">frontend dev</p>
      <p>
        <span role="img" aria-label="waving hand">👋</span>
        <a href="mailto:hello@kcygan.dev">hello@kcygan.dev</a>
      </p>
      <a href="https://cal.com/kcygan/30min">Book a meeting</a>
    </div>
  </div>
</Layout>

<style>
  .landing {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 82vh;
  }

  .container {
    text-align: center;
    animation: fadeIn 0.4s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .avatar {
    height: 180px;
    width: 180px;
    border-radius: 100%;
    object-fit: cover;
    margin-bottom: 1.25rem;
  }

  h1 {
    font-size: 3.5rem;
    margin-bottom: 0.25rem;
  }

  .subtitle {
    font-size: 1.4rem;
    margin-bottom: 1.25rem;
    color: hsla(0, 0%, 0%, 0.5);
  }

  p {
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }

  a {
    text-decoration: none;
    color: inherit;
    position: relative;
    background-image: linear-gradient(
      hsla(150, 40%, 75%, 0.7),
      hsla(150, 40%, 75%, 0.7)
    );
    background-repeat: no-repeat;
    background-size: 100% 0.2em;
    background-position: 0 88%;
    transition: background-size 0.25s ease-in;
  }

  a:hover {
    background-size: 100% 88%;
  }
</style>
