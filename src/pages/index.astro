---
import PostList from '../components/PostList.astro';
import Layout from '../layouts/Layout.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
---

<Layout
  title="Home"
  description="Writing by Kacper Cygan on software, products, and work."
>
  <div class="writing-page">
    <h1>Writing</h1>

    {posts.length > 0 ? (
      <PostList posts={posts} />
    ) : (
      <p class="empty">The first piece is on its way.</p>
    )}
  </div>
</Layout>

<style>
  .writing-page {
    width: min(100% - 3rem, var(--measure));
    margin: 4rem auto;
  }

  h1 {
    margin: 0 0 2.5rem;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .empty {
    color: var(--muted);
  }

  @media (max-width: 36rem) {
    .writing-page {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 3rem;
    }
  }
</style>
