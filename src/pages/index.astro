---
import AshbyLink from '../components/AshbyLink.astro';
import PostList from '../components/PostList.astro';
import Layout from '../layouts/Layout.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
---

<Layout
  title="Home"
  description="The personal website and writing archive of Kacper Cygan, a product engineer at Ashby."
>
  <div class="home">
    <section class="writing" aria-labelledby="writing-title">
      <header class="writing-header">
        <h1 id="writing-title">Writing</h1>
        <p>Things I wanted to put into words.</p>
      </header>
      {posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <p class="empty">The first piece is on its way.</p>
      )}
    </section>

    <details class="about-note">
      <summary>About this site</summary>
      <div class="about-note-content">
        <p>
          I’m a product engineer at <AshbyLink />. My opinions and thoughts are my own,
          you have been warned.
        </p>
        <p class="about-links">
          <a href="/about">More about me</a>
          <span aria-hidden="true">·</span>
          <a href="mailto:hello@kcygan.dev">Email me</a>
        </p>
      </div>
    </details>
  </div>
</Layout>

<style>
  .home {
    width: min(100% - 3rem, var(--measure));
    margin: 4rem auto 0;
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .writing-header p {
    max-width: 35rem;
    margin: 0.75rem 0 2.5rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .empty {
    padding-block: 1.25rem;
    border-block: 1px solid var(--rule);
    color: var(--muted);
  }

  .about-note {
    margin-top: 4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
    font-size: 0.82rem;
  }

  .about-note summary {
    width: fit-content;
    cursor: pointer;
    color: var(--ink);
  }

  .about-note-content {
    max-width: 35rem;
    padding-top: 0.9rem;
  }

  .about-note-content p {
    margin: 0;
  }

  .about-links {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    padding-top: 0.8rem;
  }

  .about-links a {
    color: var(--ink);
  }

  @media (max-width: 36rem) {
    .home {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 3rem;
    }
  }
</style>
