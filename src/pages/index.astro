---
import PostList from '../components/PostList.astro';
import Layout from '../layouts/Layout.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = (await getPublishedPosts()).slice(0, 5);
---

<Layout
  title="Home"
  description="Kacper Cygan is a software developer who writes about technology, products, and work."
>
  <div class="home">
    <section class="intro" aria-labelledby="intro-title">
      <p class="eyebrow">Hello, I’m Kacper.</p>
      <h1 id="intro-title">I build software and write about what I learn along the way.</h1>
      <p class="lede">
        I’m a software developer interested in useful products, thoughtful interfaces,
        and doing good work. This is my small corner of the internet for ideas worth
        returning to.
      </p>
      <p class="elsewhere">
        <a href="mailto:hello@kcygan.dev">Email me</a>
        <span aria-hidden="true">·</span>
        <a href="https://cal.com/kcygan/30min">Book a conversation</a>
      </p>
    </section>

    <section class="writing" aria-labelledby="writing-title">
      <div class="section-heading">
        <h2 id="writing-title">Latest writing</h2>
        <a href="/blog">All writing <span aria-hidden="true">→</span></a>
      </div>
      {posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <p class="empty">The first piece is on its way.</p>
      )}
    </section>
  </div>
</Layout>

<style>
  .home {
    width: min(100% - 3rem, var(--measure));
    margin: 5.5rem auto 0;
  }

  .intro {
    max-width: 41rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 14ch;
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.65rem, 7vw, 4.35rem);
    font-weight: 500;
    letter-spacing: -0.045em;
    line-height: 0.99;
    text-wrap: balance;
  }

  .lede {
    max-width: 37rem;
    margin: 1.8rem 0 0;
    color: #4d4a44;
    font-size: 1.08rem;
    line-height: 1.7;
    text-wrap: pretty;
  }

  .elsewhere {
    display: flex;
    gap: 0.7rem;
    align-items: center;
    margin: 1.25rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .elsewhere a {
    color: var(--ink);
  }

  .writing {
    margin-top: 6.5rem;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.1rem;
  }

  .section-heading h2 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .section-heading a {
    color: var(--muted);
    font-size: 0.78rem;
    text-decoration: none;
  }

  .section-heading a:hover {
    color: var(--accent);
  }

  .empty {
    padding-block: 1.25rem;
    border-block: 1px solid var(--rule);
    color: var(--muted);
  }

  @media (max-width: 36rem) {
    .home {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 3.75rem;
    }

    h1 {
      font-size: clamp(2.55rem, 13vw, 3.5rem);
    }

    .lede {
      margin-top: 1.5rem;
      font-size: 1.02rem;
    }

    .writing {
      margin-top: 5rem;
    }
  }
</style>
