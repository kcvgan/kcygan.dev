---
import PostList from '../components/PostList.astro';
import Layout from '../layouts/Layout.astro';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();
---

<Layout
  title="Home"
  description="The personal website and writing archive of Kacper Cygan, a product engineer at Ashby."
>
  <div class="home">
    <section class="writing" aria-labelledby="writing-title">
      <h1 id="writing-title">Writing</h1>
      {posts.length > 0 ? (
        <PostList posts={posts} />
      ) : (
        <p class="empty">The first piece is on its way.</p>
      )}
    </section>

  </div>
</Layout>

<style>
  .home {
    width: min(100% - 3rem, var(--measure));
    margin: 4rem auto 0;
  }

  h1 {
    margin: 0 0 1.75rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--rule);
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .empty {
    padding-block: 1.25rem;
    border-block: 1px solid var(--rule);
    color: var(--muted);
  }

  @media (max-width: 36rem) {
    .home {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 3rem;
    }
  }
</style>
