---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found">
  <div class="not-found">
    <p class="eyebrow">404</p>
    <h1>This page wandered off.</h1>
    <p>There’s nothing here, but there is plenty to read elsewhere.</p>
    <a href="/">Return home <span aria-hidden="true">→</span></a>
  </div>
</Layout>

<style>
  .not-found {
    width: min(100% - 3rem, var(--measure));
    margin: 7rem auto 0;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--accent);
    font-size: 0.76rem;
    font-weight: 650;
    letter-spacing: 0.1em;
  }

  h1 {
    margin: 0;
    font-family: var(--font-serif);
    font-size: clamp(2.6rem, 7vw, 4rem);
    font-weight: 500;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  p:not(.eyebrow) {
    margin: 1.25rem 0;
    color: var(--muted);
  }

  @media (max-width: 36rem) {
    .not-found {
      width: min(100% - 2.5rem, var(--measure));
      margin-top: 5rem;
    }
  }
</style>
